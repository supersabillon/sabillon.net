---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Joel Sabillon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100%;
      height: 100%;
      overflow-x: hidden;
    }

    body {
      background-color: #0d0d0d;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .name-container {
      text-align: center;
      user-select: none;
    }

    .name-joel {
      font-family: 'Creepster', cursive;
      font-size: clamp(60px, 10vw, 120px);
      color: #e8e8e8;
      display: block;
      line-height: 1;
      letter-spacing: 0.06em;
      text-shadow:
        0 0 20px #ff2222,
        0 0 45px #ff0000,
        0 0 70px rgba(255,0,0,0.45),
        3px 3px 0 #440000;
    }

    .name-sabillon {
      font-family: 'Creepster', cursive;
      font-size: clamp(60px, 10vw, 120px);
      color: #e8e8e8;
      display: block;
      line-height: 1.1;
      letter-spacing: 0.1em;
      text-shadow:
        0 0 20px #ff2222,
        0 0 45px #ff0000,
        0 0 70px rgba(255,0,0,0.45),
        3px 3px 0 #440000;
    }

    @keyframes glitch {
      0%,100% { clip-path: inset(0 0 90% 0); transform: translate(-3px, 0); }
      20%     { clip-path: inset(40% 0 40% 0); transform: translate(3px, 0); }
      40%     { clip-path: inset(70% 0 10% 0); transform: translate(-2px, 0); }
      60%     { clip-path: inset(20% 0 60% 0); transform: translate(2px, 0); }
      80%     { clip-path: inset(80% 0 5% 0); transform: translate(-3px, 0); }
    }

    .footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      border-top: 1px solid #222;
      display: flex;
      justify-content: center;
      gap: 32px;
      padding: 14px 0;
      background: #0d0d0d;
    }

    .footer-link {
      position: relative;
      text-decoration: none;
      display: inline-block;
    }

    .link-label {
      font-family: 'Creepster', cursive;
      font-size: 15px;
      letter-spacing: 0.06em;
      color: #e0e0e0;
      display: block;
      transition: text-shadow 0.1s;
    }

    .footer-link:hover .link-label {
      text-shadow: 0 0 10px #ff2222, 0 0 25px #ff0000;
    }

    .g1, .g2 {
      font-family: 'Creepster', cursive;
      font-size: 15px;
      letter-spacing: 0.06em;
      position: absolute;
      top: 0;
      left: 0;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.05s;
    }

    .g1 { color: #ff0033; animation: glitch 0.4s steps(1) infinite; }
    .g2 { color: #00ffee; animation: glitch 0.4s steps(1) infinite 0.1s; }

    .footer-link:hover .g1 { opacity: 1; }
    .footer-link:hover .g2 { opacity: 0.7; }
  </style>
</head>
<body>
  <div class="name-container">
    <span class="name-joel">JOEL</span>
    <span class="name-sabillon">SABILLON</span>
  </div>

  <nav class="footer">
    <a class="footer-link" href="https://github.com/supersabillon" target="_blank">
      <span class="link-label">GitHub</span>
      <span class="g1">GitHub</span>
      <span class="g2">GitHub</span>
    </a>
    <a class="footer-link" href="https://instagram.com/supersabillon" target="_blank">
      <span class="link-label">Instagram</span>
      <span class="g1">Instagram</span>
      <span class="g2">Instagram</span>
    </a>
    <a class="footer-link" href="https://x.com/supersabillon" target="_blank">
      <span class="link-label">X</span>
      <span class="g1">X</span>
      <span class="g2">X</span>
    </a>
    <a class="footer-link" href="/projects">
      <span class="link-label">Projects</span>
      <span class="g1">Projects</span>
      <span class="g2">Projects</span>
    </a>
  </nav>

  <script>
    const nameEl = document.querySelector('.name-container');
    document.addEventListener('mousemove', (e) => {
      const rect = nameEl.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = e.clientX - cx;
      const dy = e.clientY - cy;
      const dist = Math.sqrt(dx * dx + dy * dy) || 1;
      const ox = (-dx / dist * 6).toFixed(1);
      const oy = (-dy / dist * 6).toFixed(1);
      document.querySelectorAll('.name-joel, .name-sabillon').forEach(n => {
        n.style.textShadow = `0 0 20px #ff2222, 0 0 45px #ff0000, 0 0 70px rgba(255,0,0,0.45), ${ox}px ${oy}px 0 #440000`;
      });
    });
  </script>
</body>
</html>
